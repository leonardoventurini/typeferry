{
  "name": "typeferry-react-mongodb-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.5.1",
    "npm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.5.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "develop": "tsx develop.ts",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --supported:decorators=false --outfile=dist/server/index.cjs --sourcemap",
    "start": "node dist/server/index.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.develop.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:browser",
    "test:unit": "vitest --config vitest.config.unit.ts --run",
    "test:integration": "vitest --config vitest.config.integration.ts --run",
    "test:browser": "vitest --config vitest.config.browser.ts --run",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts",
    "test:browser:watch": "vitest --config vitest.config.browser.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "typeferry-ts": "file:../typeferry-ts",
    "mongodb": "^7.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@eslint/js": "9.39.5",
    "@rollup/plugin-babel": "7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0",
    "jiti": "2.6.1",
    "mongodb-memory-server": "10.4.1",
    "playwright": "1.62.1",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tree-kill": "^1.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "es5-ext": true,
    "esbuild": true,
    "mongodb-memory-server": true,
    "unrs-resolver": true
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
