{
  "name": "@example-app/bifrost",
  "version": "0.3.4",
  "description": "Type-safe real-time RPC framework for TypeScript",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./lit": {
      "types": "./dist/lit/index.d.ts",
      "import": "./dist/lit/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/decorators": {
      "types": "./dist/server/decorators/index.d.ts",
      "import": "./dist/server/decorators/index.js"
    },
    "./server/transports": {
      "types": "./dist/server/transports/index.d.ts",
      "import": "./dist/server/transports/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/server/oauth": {
      "types": "./dist/auth/server/oauth/index.d.ts",
      "import": "./dist/auth/server/oauth/index.js"
    },
    "./auth/client/oauth": {
      "types": "./dist/auth/client/oauth/index.d.ts",
      "import": "./dist/auth/client/oauth/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ejson": {
      "types": "./dist/ejson/index.d.ts",
      "import": "./dist/ejson/index.js"
    },
    "./mongodb": {
      "types": "./dist/mongodb/index.d.ts",
      "import": "./dist/mongodb/index.js"
    },
    "./mongodb/decorators": {
      "types": "./dist/mongodb/decorators/index.d.ts",
      "import": "./dist/mongodb/decorators/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:browser",
    "test:watch": "bun run test:unit:watch",
    "test:unit": "vitest --config vitest.config.unit.ts --run --watch=false",
    "test:unit:watch": "vitest --config vitest.config.unit.ts --watch",
    "test:coverage": "vitest --config vitest.config.unit.ts --run --coverage",
    "test:integration": "vitest --config vitest.config.integration.ts --run --watch=false",
    "test:integration:watch": "vitest --config vitest.config.integration.ts --watch",
    "test:browser": "vitest --config vitest.config.browser.ts --run --watch=false",
    "test:browser:watch": "vitest --config vitest.config.browser.ts --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "publishConfig": {
    "registry": "https://forgejo.example-app.com/api/packages/leonardoventurini/npm/"
  },
  "dependencies": {
    "@lukeed/uuid": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fast-deep-equal": "^3.1.3",
    "google-auth-library": "^10.9.0",
    "hono": "^4.13.3",
    "jsonwebtoken": "^9.0.2",
    "limiter": "^2.1.0",
    "memoizee": "^0.4.15",
    "query-string": "^7.1.3",
    "redis": "^4.6.7",
    "ua-parser-js": "^2.0.10",
    "use-debounce": "^10.1.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "mongodb": ">=6",
    "lit": ">=3",
    "react": ">=18",
    "@react-oauth/google": ">=0.12"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@react-oauth/google": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@react-oauth/google": "^0.12.2",
    "@testing-library/react": "^13.3.0",
    "@types/bun": "^1.3.14",
    "@types/cors": "^2",
    "@types/express": "^5.0.3",
    "@types/json-stable-stringify": "^1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/memoizee": "^0",
    "@types/node": "^25.2.1",
    "@types/sinon": "^10.0.16",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/ws": "^8",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "lit": "^3.3.2",
    "mongodb": "^7.5.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sinon": "^18.0.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.9",
    "form-data": "^4.0.6",
    "ip-address": "^10.5.0",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.26",
    "qs": "^6.15.3",
    "undici": "^7.29.0",
    "vite": "^7.3.3"
  }
}
