{
  "name": "void:true preserves the success body (TS + Python parity)",
  "setup": {
    "methods": [
      {"name": "ping", "handler": "return_const:pong"}
    ]
  },
  "request": {
    "headers": {"content-type": "text/plain"},
    "body": "{\"context\":{},\"payload\":{\"method\":\"ping\",\"void\":true}}"
  },
  "response": {
    "status": 200,
    "decoded": {
      "type": "result",
      "method": "ping",
      "result": "pong"
    }
  }
}
