{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true
  },
  "include": ["src/minimongo/**/*.ts"],
  "exclude": ["src/minimongo/**/*.spec.ts"]
}
